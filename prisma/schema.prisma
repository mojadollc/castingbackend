generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT
  FINANCE
  CMS_EDITOR
  GUARDIAN
  TALENT
  CASTING_PROFESSIONAL
  ORGANIZATION_ADMIN
  CASTING_DIRECTOR
  REVIEWER
  CLIENT
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
  BANNED
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum MediaType {
  PHOTO
  VIDEO
  AUDIO
  DOCUMENT
}

enum MediaStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ProjectStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
  CLOSED
  CANCELLED
  COMPLETED
}

enum AuditionMethod {
  IN_PERSON
  VIRTUAL
  SELF_TAPE
  OPEN_CALL
}

enum ApplicationStatus {
  SUBMITTED
  VIEWED
  SHORTLISTED
  AUDITION_REQUESTED
  CALLBACK
  SELECTED
  NOT_SELECTED
  WITHDRAWN
  CLOSED
}

enum AuditionStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AuditionType {
  IN_PERSON
  VIRTUAL
  SELF_TAPE
  CALLBACK
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
  TRIALING
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum NotificationType {
  APPLICATION_UPDATE
  AUDITION_SCHEDULED
  MESSAGE_RECEIVED
  INVITATION
  SUBSCRIPTION
  SYSTEM
  MODERATION
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  ESCALATED
  RESOLVED
  DISMISSED
}

enum AppealStatus {
  PENDING
  UNDER_REVIEW
  UPHELD
  REJECTED
}

enum VerificationType {
  EMAIL
  PHONE
  PASSWORD_RESET
}

enum OrgMemberRole {
  ADMIN
  CASTING_DIRECTOR
  REVIEWER
  CLIENT
}

// ─── USERS ───────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  phone             String?   @unique
  passwordHash      String
  role              UserRole  @default(GUARDIAN)
  status            UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions          UserSession[]
  verifications     UserVerification[]
  consents          UserConsent[]
  guardianProfile   GuardianProfile?
  professionalProfile ProfessionalProfile?
  orgMemberships    OrganizationMember[]
  sentMessages      Message[]           @relation("SentMessages")
  notifications     Notification[]
  reports           Report[]            @relation("ReportedBy")
  auditLogs         AuditLog[]

  @@map("users")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  deviceInfo   Json?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model UserVerification {
  id        String           @id @default(uuid())
  userId    String
  type      VerificationType
  token     String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_verifications")
}

model UserConsent {
  id          String   @id @default(uuid())
  userId      String
  consentType String
  version     String
  acceptedAt  DateTime @default(now())
  ipAddress   String?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_consents")
}

// ─── GUARDIAN ────────────────────────────────────────────────────────────────

model GuardianProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  firstName    String
  lastName     String
  avatarUrl    String?
  bio          String?
  countryId    String?
  stateId      String?
  cityId       String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  talents      TalentProfile[]
  country      Country? @relation(fields: [countryId], references: [id])

  @@map("guardian_profiles")
}

// ─── TALENT ──────────────────────────────────────────────────────────────────

model TalentProfile {
  id                  String   @id @default(uuid())
  guardianId          String
  firstName           String
  lastName            String
  dateOfBirth         DateTime
  gender              Gender
  bio                 String?
  headshot            String?
  height              Float?
  weight              Float?
  eyeColor            String?
  hairColor           String?
  hairLength          String?
  skinTone            String?
  shoeSize            String?
  clothingSize        String?
  unionMember         Boolean  @default(false)
  unionName           String?
  isAvailable         Boolean  @default(true)
  profileCompletion   Int      @default(0)
  countryId           String?
  stateId             String?
  cityId              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  guardian            GuardianProfile   @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  photos              TalentPhoto[]
  videos              TalentVideo[]
  audios              TalentAudio[]
  skills              TalentSkill[]
  languages           TalentLanguage[]
  credits             TalentCredit[]
  training            TalentTraining[]
  socialLinks         TalentSocialLink[]
  applications        Application[]
  auditions           Audition[]
  invitations         Invitation[]
  shortlistEntries    ShortlistTalent[]
  country             Country?          @relation(fields: [countryId], references: [id])

  @@map("talent_profiles")
}

model TalentPhoto {
  id          String      @id @default(uuid())
  talentId    String
  mediaFileId String
  isPrimary   Boolean     @default(false)
  caption     String?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())

  talent      TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  mediaFile   MediaFile     @relation(fields: [mediaFileId], references: [id])

  @@map("talent_photos")
}

model TalentVideo {
  id          String      @id @default(uuid())
  talentId    String
  mediaFileId String
  title       String?
  description String?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())

  talent      TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  mediaFile   MediaFile     @relation(fields: [mediaFileId], references: [id])

  @@map("talent_videos")
}

model TalentAudio {
  id          String      @id @default(uuid())
  talentId    String
  mediaFileId String
  title       String?
  createdAt   DateTime    @default(now())

  talent      TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  mediaFile   MediaFile     @relation(fields: [mediaFileId], references: [id])

  @@map("talent_audio")
}

model TalentSkill {
  id        String        @id @default(uuid())
  talentId  String
  skillId   String
  level     String?

  talent    TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  skill     Skill         @relation(fields: [skillId], references: [id])

  @@unique([talentId, skillId])
  @@map("talent_skills")
}

model TalentLanguage {
  id         String        @id @default(uuid())
  talentId   String
  languageId String
  fluency    String?

  talent     TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  language   Language      @relation(fields: [languageId], references: [id])

  @@unique([talentId, languageId])
  @@map("talent_languages")
}

model TalentCredit {
  id          String        @id @default(uuid())
  talentId    String
  title       String
  role        String?
  type        String?
  year        Int?
  director    String?
  description String?
  createdAt   DateTime      @default(now())

  talent      TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@map("talent_credits")
}

model TalentTraining {
  id           String        @id @default(uuid())
  talentId     String
  institution  String
  course       String
  instructor   String?
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime      @default(now())

  talent       TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@map("talent_training")
}

model TalentSocialLink {
  id        String        @id @default(uuid())
  talentId  String
  platform  String
  url       String

  talent    TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@unique([talentId, platform])
  @@map("talent_social_links")
}

// ─── PROFESSIONAL ─────────────────────────────────────────────────────────────

model ProfessionalProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  firstName    String
  lastName     String
  companyName  String?
  title        String?
  bio          String?
  avatarUrl    String?
  website      String?
  isVerified   Boolean  @default(false)
  countryId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents    ProfessionalDocument[]
  projects     CastingProject[]

  @@map("professional_profiles")
}

model ProfessionalDocument {
  id             String              @id @default(uuid())
  professionalId String
  mediaFileId    String
  docType        String
  verifiedAt     DateTime?
  createdAt      DateTime            @default(now())

  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  mediaFile      MediaFile           @relation(fields: [mediaFileId], references: [id])

  @@map("professional_documents")
}

// ─── ORGANIZATIONS ────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  website     String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]
  projects    CastingProject[]

  @@map("organizations")
}

model OrganizationMember {
  id             String        @id @default(uuid())
  organizationId String
  userId         String
  role           OrgMemberRole @default(REVIEWER)
  joinedAt       DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

// ─── CASTING ──────────────────────────────────────────────────────────────────

model CastingProject {
  id               String              @id @default(uuid())
  professionalId   String?
  organizationId   String?
  title            String
  description      String?
  categoryId       String?
  projectType      String?
  status           ProjectStatus       @default(DRAFT)
  auditionMethod   AuditionMethod?
  applicationStart DateTime?
  applicationEnd   DateTime?
  shootStart       DateTime?
  shootEnd         DateTime?
  location         String?
  isRemote         Boolean             @default(false)
  isPaid           Boolean             @default(false)
  compensation     String?
  isPublic         Boolean             @default(true)
  slug             String?             @unique
  submittedAt      DateTime?
  publishedAt      DateTime?
  moderationNote   String?
  viewCount        Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  professional     ProfessionalProfile? @relation(fields: [professionalId], references: [id])
  organization     Organization?        @relation(fields: [organizationId], references: [id])
  roles            CastingRole[]
  attachments      CastingAttachment[]
  applications     Application[]
  invitations      Invitation[]
  shortlists       Shortlist[]

  @@map("casting_projects")
}

model CastingRole {
  id                  String         @id @default(uuid())
  projectId           String
  name                String
  description         String?
  genderReq           Gender?
  ageMin              Int?
  ageMax              Int?
  experienceLevel     String?
  skills              Json?
  languages           Json?
  location            String?
  isRemote            Boolean        @default(false)
  isPaid              Boolean        @default(false)
  compensation        String?
  compensationAmount  Decimal?
  compensationCurrency String?       @default("USD")
  applicationRequirements Json?
  spotsTotal          Int            @default(1)
  spotsFilled         Int            @default(0)
  isFilled            Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  project      CastingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applications Application[]
  invitations  Invitation[]

  @@map("casting_roles")
}

model CastingAttachment {
  id          String         @id @default(uuid())
  projectId   String
  mediaFileId String
  label       String?
  createdAt   DateTime       @default(now())

  project     CastingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaFile   MediaFile      @relation(fields: [mediaFileId], references: [id])

  @@map("casting_attachments")
}

// ─── APPLICATIONS ─────────────────────────────────────────────────────────────

model Application {
  id          String            @id @default(uuid())
  talentId    String
  projectId   String
  roleId      String?
  status      ApplicationStatus @default(SUBMITTED)
  coverNote   String?
  notes       String?
  tags        String[]          @default([])
  rating      Int?
  viewedAt    DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  talent      TalentProfile     @relation(fields: [talentId], references: [id], onDelete: Cascade)
  project     CastingProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role        CastingRole?      @relation(fields: [roleId], references: [id])
  answers     ApplicationAnswer[]
  assets      ApplicationAsset[]
  statusHistory ApplicationStatusHistory[]
  auditions   Audition[]
  invitation  Invitation?
  shortlistEntries ShortlistTalent[]

  @@unique([talentId, projectId, roleId])
  @@map("applications")
}

model ApplicationAnswer {
  id            String      @id @default(uuid())
  applicationId String
  question      String
  answer        String

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_answers")
}

model ApplicationAsset {
  id            String      @id @default(uuid())
  applicationId String
  mediaFileId   String

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  mediaFile     MediaFile   @relation(fields: [mediaFileId], references: [id])

  @@map("application_assets")
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  status        ApplicationStatus
  note          String?
  changedAt     DateTime          @default(now())

  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_status_history")
}

model Invitation {
  id             String           @id @default(uuid())
  applicationId  String?          @unique
  projectId      String
  roleId         String?
  talentId       String
  sentByUserId   String
  guardianUserId String
  message        String?
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime?
  respondedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  application    Application?     @relation(fields: [applicationId], references: [id])
  project        CastingProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role           CastingRole?     @relation(fields: [roleId], references: [id])
  talent         TalentProfile    @relation(fields: [talentId], references: [id])

  @@map("invitations")
}

model Audition {
  id            String         @id @default(uuid())
  applicationId String
  talentId      String
  type          AuditionType   @default(IN_PERSON)
  scheduledAt   DateTime?
  location      String?
  meetingUrl    String?
  selfTapeUrl   String?
  selfTapeDueAt DateTime?
  callbackAt    DateTime?
  status        AuditionStatus @default(SCHEDULED)
  notes         String?
  feedback      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  talent        TalentProfile  @relation(fields: [talentId], references: [id])

  @@map("auditions")
}

// ─── SHORTLISTS ──────────────────────────────────────────────────────────────

model Shortlist {
  id          String           @id @default(uuid())
  projectId   String
  name        String
  description String?
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project     CastingProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  talents     ShortlistTalent[]

  @@map("shortlists")
}

model ShortlistTalent {
  id            String        @id @default(uuid())
  shortlistId   String
  talentId      String
  applicationId String?
  note          String?
  addedAt       DateTime      @default(now())

  shortlist     Shortlist     @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  talent        TalentProfile @relation(fields: [talentId], references: [id])
  application   Application?  @relation(fields: [applicationId], references: [id])

  @@unique([shortlistId, talentId])
  @@map("shortlist_talents")
}

// ─── MESSAGING ────────────────────────────────────────────────────────────────

model Conversation {
  id        String               @id @default(uuid())
  subject   String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  members   ConversationMember[]
  messages  Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  status         MessageStatus @default(SENT)
  createdAt      DateTime      @default(now())

  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation("SentMessages", fields: [senderId], references: [id])
  attachments    MessageAttachment[]

  @@map("messages")
}

model MessageAttachment {
  id          String    @id @default(uuid())
  messageId   String
  mediaFileId String

  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaFile   MediaFile @relation(fields: [mediaFileId], references: [id])

  @@map("message_attachments")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model NotificationPreference {
  id        String  @id @default(uuid())
  userId    String  @unique
  email     Boolean @default(true)
  sms       Boolean @default(true)
  push      Boolean @default(true)
  inApp     Boolean @default(true)

  @@map("notification_preferences")
}

// ─── SUBSCRIPTIONS ────────────────────────────────────────────────────────────

model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  price       Decimal
  currency    String   @default("USD")
  interval    String
  features    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id               String             @id @default(uuid())
  userId           String
  planId           String
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  plan             SubscriptionPlan   @relation(fields: [planId], references: [id])
  events           SubscriptionEvent[]
  payments         Payment[]

  @@map("subscriptions")
}

model SubscriptionEvent {
  id             String       @id @default(uuid())
  subscriptionId String
  event          String
  data           Json?
  createdAt      DateTime     @default(now())

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_events")
}

// ─── PAYMENTS ─────────────────────────────────────────────────────────────────

model Payment {
  id             String        @id @default(uuid())
  subscriptionId String?
  userId         String
  amount         Decimal
  currency       String        @default("USD")
  status         PaymentStatus @default(PENDING)
  provider       String?
  providerRef    String?
  createdAt      DateTime      @default(now())

  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  transactions   PaymentTransaction[]
  invoice        Invoice?

  @@map("payments")
}

model PaymentTransaction {
  id        String   @id @default(uuid())
  paymentId String
  type      String
  amount    Decimal
  data      Json?
  createdAt DateTime @default(now())

  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_transactions")
}

model Invoice {
  id        String   @id @default(uuid())
  paymentId String   @unique
  number    String   @unique
  pdfUrl    String?
  issuedAt  DateTime @default(now())

  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Coupon {
  id          String    @id @default(uuid())
  code        String    @unique
  discount    Decimal
  isPercent   Boolean   @default(true)
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@map("coupons")
}

// ─── MEDIA ────────────────────────────────────────────────────────────────────

model MediaFile {
  id           String      @id @default(uuid())
  uploadedBy   String
  type         MediaType
  status       MediaStatus @default(PENDING)
  originalName String
  mimeType     String
  size         Int
  url          String?
  cdnUrl       String?
  metadata     Json?
  createdAt    DateTime    @default(now())

  photos       TalentPhoto[]
  videos       TalentVideo[]
  audios       TalentAudio[]
  profDocs     ProfessionalDocument[]
  castingAttachments CastingAttachment[]
  appAssets    ApplicationAsset[]
  msgAttachments MessageAttachment[]
  processingJobs MediaProcessingJob[]

  @@map("media_files")
}

model MediaProcessingJob {
  id          String    @id @default(uuid())
  mediaFileId String
  jobType     String
  status      String    @default("pending")
  result      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  mediaFile   MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  @@map("media_processing_jobs")
}

// ─── MODERATION ───────────────────────────────────────────────────────────────

model Report {
  id           String       @id @default(uuid())
  reportedById String
  assignedToId String?
  entityType   String
  entityId     String
  reason       String
  description  String?
  status       ReportStatus @default(OPEN)
  priority     String       @default("normal") // low | normal | high | critical
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reportedBy   User              @relation("ReportedBy", fields: [reportedById], references: [id])
  safetyCase   SafetyCase?
  actions      ModerationAction[]
  evidence     ReportEvidence[]
  appeal       Appeal?

  @@map("reports")
}

model ReportEvidence {
  id          String   @id @default(uuid())
  reportId    String
  type        String   // screenshot | url | text | media_file
  content     String
  uploadedBy  String
  createdAt   DateTime @default(now())

  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("report_evidence")
}

model SafetyCase {
  id           String    @id @default(uuid())
  reportId     String    @unique
  severity     String    // low | medium | high | critical
  notes        String?
  assignedToId String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  report       Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("safety_cases")
}

model ModerationAction {
  id          String   @id @default(uuid())
  reportId    String
  action      String   // warn | suspend | ban | content_removed | case_escalated | case_resolved
  note        String?
  performedBy String
  targetUserId String?
  createdAt   DateTime @default(now())

  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("moderation_actions")
}

model Appeal {
  id          String       @id @default(uuid())
  reportId    String       @unique
  userId      String
  reason      String
  status      AppealStatus @default(PENDING)
  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  report      Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("appeals")
}

// ─── SUPPORT ──────────────────────────────────────────────────────────────────

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String
  subject     String
  body        String
  status      String   @default("open")
  priority    String   @default("normal")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("support_tickets")
}

// ─── CMS ──────────────────────────────────────────────────────────────────────

model CmsPage {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  content     String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cms_pages")
}

model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String
  coverImage  String?
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blog_posts")
}

model Faq {
  id          String   @id @default(uuid())
  question    String
  answer      String
  category    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("faqs")
}

model Review {
  id          String   @id @default(uuid())
  authorName  String
  content     String
  rating      Int
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("reviews")
}

model SuccessStory {
  id          String   @id @default(uuid())
  talentName  String
  story       String
  imageUrl    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("success_stories")
}

// ─── MASTER DATA ──────────────────────────────────────────────────────────────

model Country {
  id       String  @id @default(uuid())
  name     String  @unique
  code     String  @unique
  dialCode String?

  states   State[]
  guardians GuardianProfile[]
  talents  TalentProfile[]

  @@map("countries")
}

model State {
  id        String  @id @default(uuid())
  countryId String
  name      String
  code      String?

  country   Country @relation(fields: [countryId], references: [id])
  cities    City[]

  @@unique([countryId, name])
  @@map("states")
}

model City {
  id      String @id @default(uuid())
  stateId String
  name    String

  state   State  @relation(fields: [stateId], references: [id])

  @@unique([stateId, name])
  @@map("cities")
}

model CastingCategory {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  @@map("casting_categories")
}

model Skill {
  id      String        @id @default(uuid())
  name    String        @unique
  category String?

  talents TalentSkill[]

  @@map("skills")
}

model Language {
  id      String           @id @default(uuid())
  name    String           @unique
  code    String           @unique

  talents TalentLanguage[]

  @@map("languages")
}

// ─── AUDIT ────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
